package-as: WeakAuras

move-folders:
  WeakAuras/WeakAuras: WeakAuras
  WeakAuras/WeakAurasArchive: WeakAurasArchive
  WeakAuras/WeakAurasModelPaths: WeakAurasModelPaths
  WeakAuras/WeakAurasOptions: WeakAurasOptions
  WeakAuras/WeakAurasTemplates: WeakAurasTemplates

ignore:
  - README.md
  - CHANGES.md
  - DESCRIPTION.md
  - LICENSE
  - TakenDamage_Forever.txt
  - TUTORIAL.md
  - SUIVI-BUGS-ET-TESTS.md
  - PROCHAINE-ETAPE.md
  - RECHERCHE-AURAS-CLASSES.md
  - PLAN-AURAS-CLASSES.md
  - ANALYSE-AURAS-FOJJI.md
  - ANALYSE-AURAS-LUXTHOS.md
  - ANALYSE-AURAS-WAGO.md
  - PLAN-AURAS-V2.md
  - LISTE-AURAS-UTILITAIRES.md
  - FEATURES-A-VENIR.md
  - GUIDE.md
  - "*.zip"
  - Tests
  - Classes
